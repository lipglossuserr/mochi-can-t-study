# Mochi — required environment variables
# Copy this file to .env and fill in every value before running the app.
# All variables are required; the app logs an error on startup if any are missing.
# See README.md for where to find each Firebase value.

# Backend API base URL (no trailing slash)
# Local development: http://localhost:8080/api
# Production: https://your-backend.example.com/api
VITE_API_URL=http://localhost:8080/api

# Firebase — find all values at:
# console.firebase.google.com → Project settings → General → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
